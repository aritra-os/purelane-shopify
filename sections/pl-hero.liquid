{{ 'pl-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-hero.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Hero slideshow. Simplified from the original's 1/2/3-product stage (which
  hardcodes CSS positions for exactly those three counts) to one product per
  slide — a deliberate scope cut, documented in the build notes, made to fit
  the time available. The editor-awareness and pause-control fixes that
  matter most are kept: selecting a slide block in the sidebar pauses
  autoplay and jumps to it, and a real pause button exists because hover/
  focus-within alone leaves keyboard users no way to stop the motion.
{%- endcomment -%}

{%- assign first_block = section.blocks.first -%}
{%- assign lcp_product = first_block.settings.product -%}
{%- if lcp_product != blank and lcp_product.featured_image -%}
  <link rel="preload" as="image"
        href="{{ lcp_product.featured_image | image_url: width: 700 }}"
        fetchpriority="high">
{%- endif -%}

<div class="pl-hero" data-scene="{{ section.settings.scene }}" id="top">
  <div class="pl-wrap pl-hero__grid">

    <div class="pl-hero__copy">
      <h1 class="pl-hero__h1">{{ section.settings.heading }}</h1>
      <p class="pl-hero__lede">{{ section.settings.subheading }}</p>
      <div class="pl-hero__cta">
        <a class="pl-btn pl-btn--primary" href="{{ section.settings.cta_1_url | default: '#' }}">{{ section.settings.cta_1_label }}</a>
        <a class="pl-btn pl-btn--ghost" href="{{ section.settings.cta_2_url | default: '#' }}">{{ section.settings.cta_2_label }}</a>
      </div>
    </div>

    <pl-hero-stage class="pl-hero__stage" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}">
      <div class="pl-hero__slides">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          <div class="pl-hslide{% if forloop.first %} is-on{% endif %}"
               data-index="{{ forloop.index0 }}"
               role="group"
               aria-roledescription="slide"
               aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
               {{ block.shopify_attributes }}>

            {%- if p != blank and p.featured_image -%}
              {{ p.featured_image
                 | image_url: width: 700
                 | image_tag:
                     loading: forloop.first | ternary: 'eager', 'lazy',
                     class: 'pl-hslide__img',
                     alt: p.title | escape }}
            {%- endif -%}

            {%- if p != blank -%}
              <div class="pl-ptag">
                <span class="pl-ptag__lbl">{{ block.settings.label }}</span>
                <span class="pl-ptag__val">
                  <strong>{{ p.price | money }}</strong>
                  {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
                </span>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="pl-hdots" role="tablist" aria-label="Choose product">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" class="pl-hdot{% if forloop.first %} is-on{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
            <span class="pl-visually-hidden">Show {{ block.settings.label }}</span>
          </button>
        {%- endfor -%}
        <button type="button" class="pl-hpause" data-pause aria-pressed="false">
          <span class="pl-visually-hidden">Pause slideshow</span>
          <svg class="pl-icon-pause" viewBox="0 0 24 24" fill="currentColor" width="12" height="12" aria-hidden="true"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
          <svg class="pl-icon-play" viewBox="0 0 24 24" fill="currentColor" width="12" height="12" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        </button>
      </div>
    </pl-hero-stage>

  </div>
</div>

{% schema %}
{
  "name": "Purelane · Hero",
  "tag": "section",
  "class": "pl-section pl-section--hero",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clean That Lasts" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Homecare that works on the toughest grime, made from plants." },
    { "type": "text", "id": "cta_1_label", "label": "Primary button", "default": "Shop now" },
    { "type": "url", "id": "cta_1_url", "label": "Primary link" },
    { "type": "text", "id": "cta_2_label", "label": "Secondary button", "default": "How it works" },
    { "type": "url", "id": "cta_2_url", "label": "Secondary link" },

    { "type": "header", "content": "Slideshow" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-advance", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 3, "max": 9, "step": 1, "default": 4, "unit": "s" },
    { "type": "range", "id": "scene", "label": "Background scene", "min": 1, "max": 4, "step": 1, "default": 1 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Single bottle" },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane · Hero",
      "blocks": [
        { "type": "slide", "settings": { "label": "Single bottle" } },
        { "type": "slide", "settings": { "label": "Any 2 products" } },
        { "type": "slide", "settings": { "label": "Any 3 products" } }
      ]
    }
  ]
}
{% endschema %}
