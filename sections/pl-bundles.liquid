{{ 'pl-bundles.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Bundle tiers. Uses section blocks with a product reference rather than a
  bundle_tier metaobject — a deliberate scope cut to fit the time available.
  Price, compare-at, and the "you save" figure all come from the referenced
  product, never hardcoded, so it still meets the "real Shopify data" bar.
  A metaobject-backed version (documented in the build notes) would let a
  merchant reuse the same tier across multiple sections; this version is
  simpler to set up and fully editable, just section-scoped.
{%- endcomment -%}

<div class="pl-bundles-section" data-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">

    <div class="pl-panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pl-heading-2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="pl-tiers">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tp = block.settings.tier_product
          assign features = block.settings.features | newline_to_br | split: '<br />'
        -%}
        <article class="pl-tier{% if block.settings.highlight %} pl-tier--best{% endif %}" {{ block.shopify_attributes }}>

          {%- if block.settings.tag != blank -%}
            <span class="pl-tier__tag">{{ block.settings.tag }}</span>
          {%- endif -%}

          {%- if tp != blank and tp.featured_image -%}
            <div class="pl-tier__pix">
              {{ tp.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', class: 'pl-tier__pix-img' }}
            </div>
          {%- endif -%}

          {%- if block.settings.quantity > 0 -%}
            <div class="pl-tier__qty">{{ block.settings.quantity }}<small>Products</small></div>
          {%- endif -%}

          {%- if tp != blank -%}
            <div class="pl-tier__price">
              {{ tp.price | money }}
              {%- if tp.compare_at_price > tp.price %}<s>{{ tp.compare_at_price | money }}</s>{% endif -%}
            </div>
            {%- if block.settings.quantity > 0 -%}
              {%- assign per = tp.price | divided_by: block.settings.quantity -%}
              <p class="pl-tier__per">Flat {{ per | money }} per product</p>
            {%- endif -%}
          {%- endif -%}

          {%- if features.size > 0 -%}
            <ul class="pl-tier__features">
              {%- for f in features -%}
                {%- if f != blank -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                    {{ f }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if tp != blank -%}
            {%- form 'product', tp -%}
              <input type="hidden" name="id" value="{{ tp.selected_or_first_available_variant.id }}">
              <button type="submit" class="pl-btn {% if block.settings.highlight %}pl-btn--primary{% else %}pl-btn--ghost{% endif %}">
                Build this box
              </button>
            {%- endform -%}
          {%- endif -%}

        </article>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Purelane · Bundles",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed." },

    { "type": "header", "content": "Advanced" },
    { "type": "range", "id": "scene", "label": "Background scene", "min": 1, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Most popular" },
        { "type": "product", "id": "tier_product", "label": "Product this tier prices from" },
        { "type": "number", "id": "quantity", "label": "Products in this tier", "default": 3 },
        { "type": "textarea", "id": "features", "label": "Features", "info": "One per line", "default": "Pick any three products\nFree shipping across India" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight as most popular", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane · Bundles",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter", "quantity": 2 } },
        { "type": "tier", "settings": { "tag": "Most popular", "quantity": 3, "highlight": true } },
        { "type": "tier", "settings": { "tag": "Whole home", "quantity": 5 } }
      ]
    }
  ]
}
{% endschema %}
