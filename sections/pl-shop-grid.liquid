{{ 'pl-card.css' | asset_url | stylesheet_tag }}
{{ 'pl-shop.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<div class="pl-shop-section" data-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">

    <div class="pl-panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pl-heading-2">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if coll != blank and coll.products.size > 0 -%}
      <div class="pl-shelf">
        {%- for product in coll.products limit: limit -%}
          {% render 'pl-product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="pl-empty-note">Pick a collection in the section settings to show products here.</p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Purelane · Shop grid",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },

    { "type": "header", "content": "Advanced" },
    { "type": "range", "id": "scene", "label": "Background scene", "min": 1, "max": 4, "step": 1, "default": 3 }
  ],
  "presets": [
    { "name": "Purelane · Shop grid" }
  ]
}
{% endschema %}
